load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(":defs.bzl", "patcher_dat2jsonl", "patcher_extract")

# Data processing pipeline: extract game data → JSON release files.
#
# Requires game data to be fetched first via: bazel run //patcher:fetch
#
# Build with:
#   bazel build //patcher/pipeline:release \
#     --override_repository=gamedata+=$PWD/patcher/Content.ggpk.d/latest

# --- Extract + dat2jsonl for each table × language ---

_TABLES = ["BaseItemTypes", "ActiveSkills", "PassiveSkills", "SkillGems", "Words"]

[
    patcher_dat2jsonl(
        name = "%s_%s" % (table, lang),
        table_name = table,
        lang = lang,
    )
    for table in _TABLES
    for lang in ["en", "tc"]
]

# --- Extract stat description files ---

patcher_extract(
    name = "extract_stat_descriptions",
    path = "metadata/statdescriptions/stat_descriptions.txt",
    out = "extracted/stat_descriptions.txt",
)

patcher_extract(
    name = "extract_tincture_stat_descriptions",
    path = "metadata/statdescriptions/tincture_stat_descriptions.txt",
    out = "extracted/tincture_stat_descriptions.txt",
)

# --- Python processing: .jsonl/.txt → release JSON ---

_JSONL_SRCS = [":dat2jsonl_%s_%s" % (table, lang) for table in _TABLES for lang in ["en", "tc"]]

genrule(
    name = "datrelease",
    srcs = _JSONL_SRCS + ["//patcher/scripts:datrelease.py"],
    outs = [
        "release/bases.json",
        "release/passives.json",
        "release/words.json",
    ],
    cmd = """
        set -e
        EXTRACTDIR=$$(dirname $(location :dat2jsonl_BaseItemTypes_en))
        RELEASEDIR=$$(dirname $(location release/bases.json))
        mkdir -p out/extracted out/release
        for f in $$EXTRACTDIR/*.jsonl; do ln -sf $$PWD/$$f out/extracted/$$(basename $$f); done
        python3 $(execpath //patcher/scripts:datrelease.py)
        cp out/release/bases.json out/release/passives.json out/release/words.json $$RELEASEDIR/
    """,
)

genrule(
    name = "statparse",
    srcs = [
        ":extract_stat_descriptions",
        ":extract_tincture_stat_descriptions",
        "//patcher/scripts:statparse.py",
    ],
    outs = ["release/stat_descriptions.json"],
    cmd = "python3 $(location //patcher/scripts:statparse.py) $(location :extract_stat_descriptions) $(location :extract_tincture_stat_descriptions) > $@",
)

genrule(
    name = "charversion",
    srcs = ["@gamedata//:PathOfExile.exe", "//patcher/scripts:charversion.py"],
    outs = ["release/version.txt"],
    cmd = "python3 $(location //patcher/scripts:charversion.py) $(location @gamedata//:PathOfExile.exe) > $@",
)

genrule(
    name = "fingerprint",
    srcs = [
        "release/bases.json",
        "release/stat_descriptions.json",
        "release/words.json",
        "release/passives.json",
        "release/version.txt",
        "//patcher/scripts:fingerprint.py",
    ],
    outs = ["release/fingerprint.txt"],
    cmd = "python3 $(location //patcher/scripts:fingerprint.py) $(location release/bases.json) $(location release/stat_descriptions.json) $(location release/words.json) $(location release/passives.json) $(location release/version.txt) > $@",
)

# --- Release tarball ---

pkg_tar(
    name = "release",
    srcs = [
        "release/bases.json",
        "release/fingerprint.txt",
        "release/passives.json",
        "release/stat_descriptions.json",
        "release/version.txt",
        "release/words.json",
    ],
    mode = "0644",
    strip_prefix = "release",
    visibility = ["//visibility:public"],
)
